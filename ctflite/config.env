# ============================================================
#  ctflite - single-box, on-demand CTF
# ============================================================
# Everything here is meant to be edited. Nothing else needs to be.

# --- Linode API token ---
# Create at https://cloud.linode.com/profile/tokens  (Linodes: Read/Write)
# Checked in this order:
#   1. $LINODE_TOKEN
#   2. ./personal_access_token          (project-local, gitignored)
#   3. ../personal_access_token.txt     (the main CTF project's token)
#   4. ~/.ctflite/token
LINODE_TOKEN_FILE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/personal_access_token"
LINODE_TOKEN_FILE_ALT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/personal_access_token.txt"
LINODE_TOKEN_FILE_ALT2="${HOME}/.ctflite/token"

# --- Instance shape ---
# g6-standard-2 : 4 GB / 2 vCPU -> $0.036/hr   (default; fits CTFd + 10 challenges)
# g6-standard-1 : 2 GB / 1 vCPU -> $0.018/hr   (tight - CTFd alone wants ~1 GB)
# g6-standard-4 : 8 GB / 4 vCPU -> $0.072/hr   (headroom for many more challenges)
LINODE_TYPE="g6-standard-4"

# Any region works - this build uses no VPC, so it is not limited to us-iad
# like the full range is.  List them with:  ./ctfl regions
LINODE_REGION="us-east"

LINODE_IMAGE="linode/debian12"
LINODE_LABEL="ctflite"

# --- Event ---
EVENT_NAME="club.eh CTF (lite)"
EVENT_DESC="Beginner CTF. Challenges are reachable directly on this host."
# "users" = solo scoring, "teams" = team scoring.
# IRREVERSIBLE once CTFd has been set up - a change means a fresh backup-less up.
CTF_USER_MODE="users"
CTF_TEAM_SIZE="4"

CTFD_VERSION="3.8.7"
CTFD_ADMIN_USER="ctf-admin"
CTFD_ADMIN_EMAIL="admin@example.com"
# Leave empty to generate one on first `up`. It is stored 0600 in
# state/credentials.env and REUSED on every later up, so restored backups
# keep working. Set it explicitly if you would rather choose it.
CTFD_ADMIN_PASSWORD=""

# Registration code players must type to sign up. Empty = anyone with the URL.
CTFD_REGISTRATION_CODE=""

# --- Challenges ---
# Where the challenge definitions live. Defaults to the main project's set;
# point it at a folder of your own to run a different event.
CHALLENGES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/challenges"
# Only these are deployed. Dynamic (ctfd-whale) challenges are skipped - this
# build has no whale, no frp and no per-player instances by design.
FLAG_PREFIX="clubeh"
# Points charged per hint imported from a challenge's README. 0 = free.
HINT_COST="0"
# Name of the challenge every OTHER challenge must be solved before. Players
# see the rest as "???" until they clear it. Empty = no gating.
GATE_CHALLENGE="start-here"

# --- Access control (ufw on the box) ---
# SSH is locked to this CIDR. "auto" = whatever your public IP is at `up` time.
ADMIN_CIDR="auto"
# Who may reach CTFd and the challenge ports. "0.0.0.0/0" = the whole internet.
# Set this to your own /32 while you are still building the event.
PLAYER_CIDR="0.0.0.0/0"

# --- Backups ---
BACKUP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/backups"
BACKUP_KEEP="10"
