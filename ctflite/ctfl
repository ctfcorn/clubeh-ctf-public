cmd_logs() {
  require_state
  rsh "cd /opt/ctflite/compose && docker compose -p ctfd logs --tail ${1:-80} -f ctfd"
}

cmd_backups() {
  printf '%-30s %10s  %6s %7s  %s\n' "ARCHIVE" "SIZE" "USERS" "SOLVES" "CREATED"
  local f m
  for f in $(ls -1t "$BACKUP_DIR"/ctflite-*.tar.gz 2>/dev/null); do
    m="${f%.tar.gz}.json"
    printf '%-30s %10s  %6s %7s  %s\n' \
      "$(basename "$f")" "$(human_size "$(wc -c <"$f")")" \
      "$([[ -f "$m" ]] && jq -r '.users'  "$m" || echo '?')" \
      "$([[ -f "$m" ]] && jq -r '.solves' "$m" || echo '?')" \
      "$([[ -f "$m" ]] && jq -r '.created_utc' "$m" || echo '?')"
  done
  [[ -n "$(latest_backup)" ]] || echo "(none yet)"
}

cmd_regions() {
  load_token
  linode_api GET "/regions" | jq -r '.data[] | select(.status=="ok") | "\(.id)\t\(.label)"' | column -t -s $'\t'
}

cmd_destroy() {
  load_token; require_state
  local id; id="$(state_get id)"
  warn "This deletes Linode $id WITHOUT taking a backup. Users, solves and scores will be gone."
  confirm "Really destroy without a backup?" || { log "aborted"; exit 1; }
  linode_api DELETE "/linode/instances/$id" >/dev/null
  rm -f "$STATE_FILE"
  ok "Linode $id deleted (no backup taken)"
}

cmd_orphans() {
  load_token
  local out
  out="$(linode_api GET "/linode/instances" \
        | jq -r '.data[] | select(.tags|index("ctflite")) | "\(.id)\t\(.label)\t\(.ipv4[0])\t\(.status)\t\(.created)"')"
  if [[ -z "$out" ]]; then
    ok "No ctflite Linodes exist in your account. Nothing is billing."
  else
    warn "These tagged Linodes exist and ARE billing:"
    printf '%s\n' "$out" | column -t -s $'\t'
    echo
    dim "Delete one with:  ./ctfl down  (saves it first)  or  ./ctfl destroy"
  fi
}

# Verify everything `up` depends on WITHOUT creating anything. Free.
cmd_preflight() {
  local fail=0

  step "1. Local tooling"
  for t in curl jq ssh scp tar python3; do
    if command -v "$t" >/dev/null 2>&1; then ok "$t"; else warn "$t MISSING"; fail=1; fi
  done

  step "2. Challenge definitions in $CHALLENGES_DIR"
  if [[ ! -d "$CHALLENGES_DIR" ]]; then
    warn "directory does not exist"; fail=1
  else
    local n=0 ports="" d f name pub flag
    while read -r d; do
      [[ -z "$d" ]] && continue
      f="$d/challenge.yml"; name="$(chal_field "$f" name)"
      pub="$(chal_field "$f" published)"; flag="$(chal_field "$f" flag)"
      [[ -f "$d/Dockerfile" ]] || { warn "$name: no Dockerfile"; fail=1; }
      [[ -n "$flag" ]] || { warn "$name: no flag"; fail=1; }
      [[ "$name" == "$(basename "$d")" ]] || { warn "$name: name != directory"; fail=1; }
      case " $ports " in *" $pub "*) warn "port $pub used twice"; fail=1;; esac
      ports="$ports $pub"; n=$((n+1))
    done <<< "$(static_challenges)"
    ok "$n static challenge(s), ports:$ports"
    dim "dynamic challenges are skipped - this build has no ctfd-whale"
  fi

  step "3. CTFd image tag"
  if curl -sSf -m 20 "https://hub.docker.com/v2/repositories/ctfd/ctfd/tags/${CTFD_VERSION}" >/dev/null 2>&1; then
    ok "ctfd/ctfd:${CTFD_VERSION} exists"
  else
    warn "ctfd/ctfd:${CTFD_VERSION} not found on Docker Hub"; fail=1
  fi

  step "4. Your public IP (for ADMIN_CIDR)"
  if [[ "$ADMIN_CIDR" == "auto" ]]; then
    local v4 v6
    v4="$(my_public_ip4)"; v6="$(my_public_ip6)"
    [[ -n "$v4" ]] && ok "IPv4 $v4 -> ssh allowed from $v4/32"
    [[ -n "$v6" ]] && ok "IPv6 $v6 -> ssh allowed from $v6/128"
    if [[ -z "$v4$v6" ]]; then warn "could not detect your IP; set ADMIN_CIDR explicitly"; fail=1; fi
    [[ -z "$v4" && -n "$v6" ]] && dim "no IPv4 detected - if your SSH goes out over v4 you will be locked out; pin ADMIN_CIDR by hand"
  else
    ok "pinned to $ADMIN_CIDR"
  fi
  if [[ "$PLAYER_CIDR" == "0.0.0.0/0" ]]; then
    dim "PLAYER_CIDR is the whole internet - fine for a real event, tighten it while building"
  else
    ok "players restricted to $PLAYER_CIDR"
  fi

  step "5. Linode credentials + plan"
  load_token
  ok "token loaded from $TOKEN_SRC"
  local acct; acct="$(linode_api GET "/profile" | jq -r '.username // "?"')"
  ok "token valid (user: $acct)"
  local t; t="$(linode_api GET "/linode/types/${LINODE_TYPE}")"
  ok "plan $(jq -r '.label' <<<"$t"): $(jq -r '.memory/1024' <<<"$t")GB, $(jq -r '.vcpus' <<<"$t") vCPU, \$$(jq -r '.price.hourly' <<<"$t")/hr"
  if linode_api GET "/regions/${LINODE_REGION}" >/dev/null 2>&1; then ok "region $LINODE_REGION valid"
  else warn "region $LINODE_REGION invalid (see ./ctfl regions)"; fail=1; fi
  local running
  running="$(linode_api GET "/linode/instances" | jq -r '[.data[]|select(.tags|index("ctflite"))]|length')"
  if [[ "$running" == "0" ]]; then ok "no ctflite Linodes currently billing"
  else warn "$running ctflite Linode(s) already exist - see ./ctfl orphans"; fi

  echo
  (( fail )) && die "pre-flight found problems (listed above)"
  step "${C_GRN}Pre-flight clean - ./ctfl up should succeed${C_RST}"
}

cmd_help() {
cat <<'HELP'
ctfl - on-demand single-box CTF on Linode (CTFd + static challenges, one host)

  ./ctfl up [--fresh] [--from <archive>]
        Create a Linode, install Docker + CTFd, build and run every static
        challenge, restore your most recent verified backup (or start fresh),
        and register all challenges in CTFd with flags and hints.

  ./ctfl down
        Stop CTFd, dump the database and uploads, download the archive, run 4
        verification checks, and only then DELETE the Linode. This is the
        command that stops all charges.

  ./ctfl reprovision [--from <archive>]
        Re-run provisioning on the EXISTING box (after fixing a provisioning
        bug) instead of destroying and recreating a billing Linode.

  ./ctfl preflight    Verify tooling, challenges, CTFd tag, token and plan
                      WITHOUT creating anything. Free. Run it first.

  ./ctfl challenges   Rebuild the challenge images on the running box and
                      re-sync CTFd. Use after editing a challenge.
  ./ctfl register     Re-sync CTFd only (descriptions, points, hints, flags).

  ./ctfl reset        Wipe every account, solve and submission, keeping your
                      challenges, pages, homepage, CTF name and settings.
                      Use between events to start a clean scoreboard.

  ./ctfl accuracy     Per-player solve accuracy (solves vs total submissions)
                      and which challenges players struggled with most.

  ./ctfl backup       Snapshot + download mid-event; the box keeps running.
  ./ctfl status       Is it up, for how long, what has it cost, what is running.
  ./ctfl logs [n]     Tail the CTFd log.
  ./ctfl ssh          Shell on the box.
  ./ctfl backups      List local backups with their user/solve counts.
  ./ctfl regions      List Linode regions.
  ./ctfl orphans      Audit: any ctflite Linode still billing anywhere?
  ./ctfl destroy      Delete the Linode WITHOUT a backup (dangerous).

Billing note: a powered-off Linode still bills, because its disk is still
allocated. Only deletion stops it, which is why 'down' deletes rather than
shuts down - and why it refuses to delete until the backup verifies.
HELP
}

# =====================================================================
case "${1:-help}" in
  up)         shift; cmd_up "$@" ;;
  reprovision) shift; cmd_reprovision "$@" ;;
  down)       shift; cmd_down "$@" ;;
  backup)     shift; cmd_backup "$@" ;;
  preflight)  shift; cmd_preflight "$@" ;;
  challenges) shift; cmd_challenges "$@" ;;
  register)   shift; cmd_register "$@" ;;
  reset)      shift; cmd_reset "$@" ;;
  accuracy)   shift; cmd_accuracy "$@" ;;
  status)     shift; cmd_status "$@" ;;
  logs)       shift; cmd_logs "$@" ;;
  ssh)        shift; cmd_ssh "$@" ;;
  backups)    shift; cmd_backups "$@" ;;
  regions)    shift; cmd_regions "$@" ;;
  orphans)    shift; cmd_orphans "$@" ;;
  destroy)    shift; cmd_destroy "$@" ;;
  help|-h|--help) cmd_help ;;
  *) die "unknown command '$1'  (try ./ctfl help)" ;;
esac
